NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for /api/ingest (pg_cron sends it as a Bearer token)
CRON_SECRET=
# Optional: AI-written briefs via any OpenAI-compatible API (free tiers: Groq, Gemini, OpenRouter, Ollama).
# Without a key, /api/brief writes an extractive digest instead. See lib/brief/provider.ts.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
